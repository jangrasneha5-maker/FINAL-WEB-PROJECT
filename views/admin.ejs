<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin | Modern Musician</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .admin-wrap{max-width:1120px;margin:0 auto;padding:70px 24px}.admin-top{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:36px}.admin-panel{background:#111719;border:1px solid #343b3d;border-radius:16px;padding:24px;margin:24px 0}.admin-panel h2{margin-top:0}.admin-form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.admin-form input,.admin-form select,.admin-form textarea{width:100%;padding:13px;background:#20282a;border:1px solid #465052;color:#fff;border-radius:7px;font:inherit}.admin-form textarea{grid-column:1/-1}.admin-form button{justify-self:start}.admin-table{width:100%;border-collapse:collapse;font-size:13px}.admin-table th,.admin-table td{text-align:left;padding:12px;border-bottom:1px solid #394244}.admin-table button{margin:3px}.admin-note{color:#b8c0bf;font-size:13px}@media(max-width:700px){.admin-form{grid-template-columns:1fr}.admin-table{display:block;overflow-x:auto}.admin-top{align-items:flex-start;flex-direction:column}}
  </style>
</head>
<body>
  <header class="site-header"><nav class="navbar container"><a class="logo" href="/index.html">MUSIC<span>.</span></a><a class="nav-cta" href="/index.html">View website ↗</a></nav></header>
  <main class="admin-wrap">
    <div class="admin-top"><div><p class="eyebrow">Management space</p><h1>Admin <span>dashboard.</span></h1><p class="admin-note">Demo management page for the project evaluation. It is not password-protected.</p></div></div>
    <section class="admin-panel"><h2>Add a release</h2><form class="admin-form" id="release-form"><input name="title" placeholder="Release title" required><input name="artist" placeholder="Artist" required><input name="genre" placeholder="Genre" required><input name="releaseYear" type="number" placeholder="Release year" min="1900" max="2100" required><input name="artwork" placeholder="Artwork image URL"><textarea name="description" placeholder="Description"></textarea><button class="button button-primary" type="submit">Save release ↗</button></form><p id="release-feedback" class="admin-note" role="status"></p></section>
    <section class="admin-panel"><h2>Releases in MongoDB</h2><table class="admin-table"><thead><tr><th>Title</th><th>Artist</th><th>Genre</th><th>Year</th><th>Actions</th></tr></thead><tbody><% releases.forEach(function(item){ %><tr><td><%= item.title %></td><td><%= item.artist %></td><td><%= item.genre %></td><td><%= item.releaseYear %></td><td><button class="button button-outline edit-release" data-id="<%= item._id %>" data-title="<%= item.title %>" data-artist="<%= item.artist %>" data-genre="<%= item.genre %>" data-year="<%= item.releaseYear %>">Edit</button><button class="button button-outline" onclick="deleteRecord('/api/releases/<%= item._id %>')">Delete</button></td></tr><% }) %></tbody></table><% if (!releases.length) { %><p class="admin-note">No releases added yet.</p><% } %></section>
    <section class="admin-panel"><h2>Add a tour event</h2><form class="admin-form" id="tour-form"><input name="eventName" placeholder="Event name" required><input name="venue" placeholder="Venue" required><input name="city" placeholder="City" required><input name="date" type="date" required><input name="time" placeholder="Time (e.g. 7:30 PM)"><input name="ticketLink" placeholder="Ticket URL"><select name="status"><option value="upcoming">Upcoming</option><option value="past">Past</option></select><button class="button button-primary" type="submit">Save tour event ↗</button></form><p id="tour-feedback" class="admin-note" role="status"></p></section>
    <section class="admin-panel"><h2>Tour events in MongoDB</h2><table class="admin-table"><thead><tr><th>Event</th><th>Venue</th><th>City</th><th>Date</th><th>Actions</th></tr></thead><tbody><% events.forEach(function(item){ %><tr><td><%= item.eventName %></td><td><%= item.venue %></td><td><%= item.city %></td><td><%= new Date(item.date).toLocaleDateString() %></td><td><button class="button button-outline" onclick="deleteRecord('/api/tour/<%= item._id %>')">Delete</button></td></tr><% }) %></tbody></table><% if (!events.length) { %><p class="admin-note">No tour events added yet.</p><% } %></section>
    <section class="admin-panel"><h2>Contact messages</h2><table class="admin-table"><thead><tr><th>Name</th><th>Email</th><th>Topic</th><th>Message</th><th>Actions</th></tr></thead><tbody><% messages.forEach(function(item){ %><tr><td><%= item.name %></td><td><%= item.email %></td><td><%= item.topic %></td><td><%= item.message %></td><td><button class="button button-outline" onclick="deleteRecord('/api/messages/<%= item._id %>')">Delete</button></td></tr><% }) %></tbody></table><% if (!messages.length) { %><p class="admin-note">No contact messages received yet.</p><% } %></section>
  </main>
  <script>
    async function sendForm(formId, url, feedbackId) { const form=document.getElementById(formId); form.addEventListener('submit',async function(e){e.preventDefault();const data=Object.fromEntries(new FormData(form).entries());if(data.releaseYear)data.releaseYear=Number(data.releaseYear);try{const r=await fetch(url,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});const result=await r.json();document.getElementById(feedbackId).textContent=result.message||'Saved';if(r.ok)location.reload();}catch(err){document.getElementById(feedbackId).textContent='Could not connect to the server.';}}); }
    sendForm('release-form','/api/releases','release-feedback'); sendForm('tour-form','/api/tour','tour-feedback');
    async function deleteRecord(url){if(!confirm('Delete this record?'))return;const r=await fetch(url,{method:'DELETE'});const d=await r.json();alert(d.message);if(r.ok)location.reload();}
    document.querySelectorAll('.edit-release').forEach(function(button){button.addEventListener('click',async function(){const title=prompt('Release title:',button.dataset.title);if(title===null)return;const artist=prompt('Artist:',button.dataset.artist);if(artist===null)return;const genre=prompt('Genre:',button.dataset.genre);if(genre===null)return;const year=Number(prompt('Release year:',button.dataset.year));if(!year)return;const response=await fetch('/api/releases/'+button.dataset.id,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({title,artist,genre,releaseYear:year})});const result=await response.json();alert(result.message);if(response.ok)location.reload();});});
  </script>
</body>
</html>
